# Secrets - API keys, tokens, passwords
secrets/

# Private - Personal/company information, machine-specific paths
private/

# Docker / OrbStack runtime state
docker/.token_seed
docker/.token_seed.lock
docker/buildx/
docker/cli-plugins/
docker/config.json
docker/contexts/

# Zsh session history
zsh/.zsh_history
zsh/.zsh_sessions/

# Vim history
vim/.viminfo

# macOS
.DS_Store
**/.DS_Store

# Spicetify user-specific cache
spicetify/CustomApps/marketplace-dist.zip

# Zsh compiled bytecode cache
**/*.zwc

# Zsh completion cache — generated by brew at runtime
zsh/.zcompcache/brew_casks
zsh/.zcompcache/brew_formulae

# Matplotlib font/style cache (contains machine-specific absolute paths)
matplotlib/

# Third-party plugins / runtime cache (keep folders, ignore contents)
# These are installed or compiled by plugin managers at runtime
zi/bin
zi/plugins/*
!zi/plugins/.gitkeep
zi/completions/
zi/snippets/*
tmux/plugins/*
!tmux/plugins/.gitkeep
vim/.vim/plugged/*
!vim/.vim/plugged/.gitkeep
bundle/cache
.zcompdump

# CUPS — contains local printer names and network addresses
cups/

# Swift Package Manager — machine-specific package trust fingerprints and cache
swiftpm/

# Rclone — contains remote credentials and mount configs
rclone/

# Go workspace cache and module data
go/

# Configstore — app-generated config/state files
configstore/

# etlp — runtime data
etlp/

# OpenSpec local configuration
openspec/

# Local research notes may contain machine-specific paths.
docs/notes/

# Herdr runtime state and logs
herdr/session.json
herdr/session-history.json
herdr/release-notes.json
herdr/herdr-client.log
herdr/herdr-server.log

# Herdr's plugin registry contains machine-specific absolute paths.
herdr/plugins.json

# Herdr plugins are installed by herdr/bootstrap-plugins.sh.
herdr/plugins/github/*

# Homebrew runtime locks
homebrew/*.lock

# Android SDK cache and local debug signing key
.android/

# Raycast extension cache and runtime state
raycast/

# Herdr plugin installation lock
herdr/.plugins.lock
